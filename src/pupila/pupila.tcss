/* Pupila's built-in style.
   To change something, don't edit this file: create ~/.config/pupila/pupila.tcss
   with only what you want to change. It's applied on top of this one and reloaded live.
   Theme colours: $primary (lavender), $secondary, $accent, $surface, $panel... */

#body { height: 1fr; }

/* --- room sidebar --- */
#sidebar {
    width: 32;
    background: $surface;
    border-right: vkey $panel;
    padding: 0 0 0 1;
    scrollbar-size-vertical: 1;
}
#sidebar.-hidden { display: none; }
#sidebar > .tree--cursor { background: $primary 30%; text-style: none; }
#sidebar:focus > .tree--cursor { background: $primary 45%; }
#sidebar > .tree--guides { color: $panel; }

/* --- centre --- */
#center { width: 1fr; }
#header {
    height: 1;
    padding: 0 1;
    background: $panel;
}
#timeline {
    height: 1fr;
    padding: 0 2 0 1;
    scrollbar-size-vertical: 1;
}
#typing { height: 1; padding: 0 2; }
#action { height: auto; padding: 0 2; display: none; }
#action.-visible { display: block; }
#compose-row {
    height: auto;
    margin: 0 1;
    border: round $primary 60%;
    background: $surface;
}
#compose-row:focus-within { border: round $primary; }
#composer {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    border: none;
    padding: 0 1;
    background: $surface;
}
#composer:focus { border: none; }
IconButton { width: 3; height: 1; content-align: center middle; }
#attach-button { margin-left: 1; }
#emoji-button { margin-right: 1; }
IconButton:hover { background: $primary 30%; }
IconButton .icon-text { width: 100%; height: 1; content-align: center middle; color: $accent; text-style: bold; }


/* --- messages --- */
.message { height: auto; padding: 0 1; }
.message.-group { margin-top: 1; }
.message:hover { background: $boost; }
.message .header { height: 1; }
.message .body { height: auto; }
.message .quote { height: auto; }
.message .suffix { height: 1; }
.message .reactions { height: 1; }
.message .image { margin-top: 1; }
.message .bubble > .image { margin-top: 0; }
.message .notice { text-style: italic; }
.message .with-avatar { height: auto; }
.message .avatar-slot { width: 6; height: auto; }
.message .avatar { height: 2; width: auto; }
.message .initial {
    width: 4;
    height: 1;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    color: $background;
}
.message .content { width: 1fr; height: auto; }
.message .bubble {
    width: auto;
    max-width: 90%;
    min-width: 24;
    height: auto;
    padding: 0 1;
    background: $surface;
}
.message .bubble > .body, .message .bubble > .quote, .message .bubble > .suffix { width: auto; }
.message.-group .bubble { margin-top: 0; }
.message .reactions { width: auto; margin-left: 1; }
.day {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}
.more, .empty {
    width: 100%;
    text-align: center;
    color: $text-muted;
    padding: 1 0;
}

/* --- dialogs --- */
Menu, Confirm, Login, Settings { align: center middle; }

/* --- right-click menu, next to the cursor --- */
ContextMenu { background: transparent; align: left top; }
#context {
    width: 30;
    height: auto;
    background: $surface;
    border: round $primary;
    padding: 0;
}
#context .quick { height: 1; width: 100%; padding: 0 1; }
#context .quick-reaction { width: 4; height: 1; content-align: center middle; }
#context .quick-reaction:hover { background: $primary 40%; }
#context OptionList { height: auto; border: none; background: $surface; padding: 0; }

/* --- emoji picker --- */
EmojiPicker { background: transparent; align: left top; }
#emoji-picker {
    width: 50;
    height: 22;
    background: $surface;
    border: round $primary;
    padding: 0 1;
}
#emoji-search { width: 100%; height: 3; margin-bottom: 0; }
#emoji-main { height: 1fr; }
#emoji-cats { width: 4; height: 100%; }
#emoji-cats .cat { width: 3; height: 1; content-align: center middle; margin-bottom: 0; }
#emoji-cats .cat:hover { background: $primary 40%; }
#emoji-scroll { width: 1fr; height: 100%; scrollbar-size-vertical: 1; }
#emoji-scroll .cat-title { color: $text-muted; text-style: bold; margin-top: 1; }
#emoji-scroll EmojiGrid { width: 36; height: auto; }
#emoji-none { color: $text-muted; }
#emoji-preview { height: 1; color: $text; }

/* --- settings --- */
.settings { width: 76; height: 90%; max-height: 44; }
.settings-body { height: 1fr; padding-right: 1; }
.settings .section { text-style: bold; color: $primary; margin-top: 1; }
.settings .setting { height: auto; margin-bottom: 1; }
.settings Switch { height: 1; width: auto; border: none; padding: 0 2 0 0; background: $surface; }
.settings Switch:focus { border: none; background-tint: $primary 20%; }
.settings .setting Label { padding: 0 1; }
.settings .setting .label { width: 22; padding: 1 1 0 0; }
.settings .setting Select, .settings .setting Input { margin-bottom: 0; }
.settings Checkbox { margin-bottom: 1; }
.settings .setting Select { width: 1fr; }
.settings .setting Input { width: 10; }
.settings .hint { color: $text-muted; margin-top: 1; }
.settings #logout { margin-top: 1; }
.settings .buttons { margin-top: 1; }

/* --- attach a file (without zenity) --- */
FilePicker { align: center middle; }
.files { width: 70; height: 80%; }
.files DirectoryTree { height: 1fr; background: $surface; }

/* --- files waiting to be sent, above the composer --- */
#attachments { height: auto; margin: 0 1; padding: 0; }
#attachments .attachment {
    width: auto;
    min-width: 16;
    max-width: 36;
    height: auto;
    margin-right: 1;
    padding: 0 1;
    border: round $primary 60%;
    background: $surface;
}
#attachments .attachment-remove {
    dock: right;
    width: 1;
    height: 1;
    color: $error;
    text-style: bold;
}
#attachments .attachment-icon { height: 1; width: auto; }
#attachments .attachment-name { width: auto; height: 1; }
